generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum DocumentClassification {
  UNCLASSIFIED
  RESTRICTED
  CONFIDENTIAL
  STRICTLY_CONFIDENTIAL
}

enum IndustryTemplate {
  CORPORATE
  HOSPITAL
  LEGAL
  FINANCE
  EDUCATION
  GOVERNMENT
  CUSTOM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  LOGIN
  LOGOUT
  PERMISSION_GRANT
  PERMISSION_REVOKE
  EMBEDDING_GENERATED
  INDEXING_COMPLETED
  INDEXING_FAILED
}

enum SourceType {
  UPLOAD
  GITHUB
  NOTION
  GMAIL
  GOOGLE_DRIVE
}

enum ConnectorProvider {
  GITHUB
  NOTION
  GMAIL
  GOOGLE_DRIVE
  SLACK
}

enum DocumentScope {
  PERSONAL
  ORGANIZATION
}

enum DocumentVisibility {
  ORG_WIDE
  DEPARTMENT
  PRIVATE
}

// -----------------------------------------------------------------------------
// MULTI-TENANT FOUNDATION
// -----------------------------------------------------------------------------

model Organization {
  id               String           @id @default(uuid())
  name             String
  domain           String?          @unique
  industry         IndustryTemplate @default(CORPORATE)
  webAccessEnabled Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Relations
  departments       Department[]
  users             User[]
  roles             Role[]
  groups            Group[]
  documents         Document[]
  auditLogs         AuditLog[]
  invitations       Invitation[]
  apiKeys           APIKey[]
  jobs              ProcessingJob[]
  chunks            DocumentChunk[]
  chats             Chat[]
  messages          Message[]
  memories          UserMemory[]
  connectedAccounts ConnectedAccount[]
  connectorPolicies ConnectorPolicy[]
}

model Department {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  documents    Document[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// IDENTITY & ACCESS MANAGEMENT (IAM)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  organizationId String
  departmentId   String?
  clerkUserId    String?   @unique // External Identity Provider mapping
  email          String
  firstName      String?
  lastName       String?
  passwordHash   String? // First-party session auth (scrypt)
  isSuperAdmin   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  groupMembers        GroupMember[]
  userRoles           UserRole[]
  ownedDocuments      Document[]           @relation("DocumentOwner")
  documentPermissions DocumentPermission[]
  chats               Chat[]
  messages            Message[]
  memories            UserMemory[]
  sessions            Session[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  connectedAccounts   ConnectedAccount[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
}

model Role {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  Permission[]
  userRoles    UserRole[]
  groupRoles   GroupRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id         String   @id @default(uuid())
  roleId     String
  action     String // e.g., "DOC_DELETE", "USER_INVITE"
  resource   String // e.g., "Document", "User"
  conditions Json? // ABAC Conditions
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
  @@index([roleId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Group {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      GroupMember[]
  groupRoles   GroupRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model GroupMember {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupRole {
  groupId String
  roleId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId])
  @@index([groupId])
  @@index([roleId])
}

model ConnectedAccount {
  id             String            @id @default(uuid())
  organizationId String
  userId         String?
  provider       ConnectorProvider
  accountId      String
  accountEmail   String?
  accessToken    String            @db.Text
  refreshToken   String?           @db.Text
  tokenIv        String?           @db.Text
  scopes         String?           @db.Text
  expiresAt      DateTime?
  status         String            @default("ACTIVE")
  lastSyncAt     DateTime?
  lastSyncStatus String? // "SUCCESS" | "ERROR" | "PENDING"
  lastError      String?           @db.Text
  lastErrorAt    DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  connectorPolicies ConnectorPolicy[]

  @@unique([provider, accountId])
  @@index([organizationId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// KNOWLEDGE GRAPH (Documents & Embeddings)
// -----------------------------------------------------------------------------

model Document {
  id                 String                 @id @default(uuid())
  organizationId     String
  ownerId            String
  title              String
  classification     DocumentClassification @default(UNCLASSIFIED)
  mimeType           String
  sizeBytes          Int
  isFavorited        Boolean                @default(false)
  visibility         DocumentVisibility     @default(PRIVATE)
  scope              DocumentScope          @default(ORGANIZATION)
  departmentId       String?
  sourceType         SourceType             @default(UPLOAD)
  externalId         String?
  sourceUrl          String?
  connectedAccountId String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  allowedRoles       String[] @default([])
  allowedUsers       String[] @default([])
  allowedDepartments String[] @default([])
  deniedRoles        String[] @default([])
  deniedUsers        String[] @default([])
  deniedDepartments  String[] @default([])

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner            User              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  versions    DocumentVersion[]
  permissions DocumentPermission[]
  jobs        ProcessingJob[]
  chunks      DocumentChunk[]

  @@index([organizationId])
  @@index([ownerId])
}

model DocumentVersion {
  id         String    @id @default(uuid())
  documentId String
  version    Int
  s3Key      String
  hash       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relations
  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@unique([documentId, version])
  @@index([documentId])
}

model ProcessingJob {
  id             String    @id @default(uuid())
  organizationId String
  documentId     String
  queueName      String
  status         String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  error          String?   @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@index([queueName])
  @@index([status])
}

model DocumentChunk {
  id              String    @id // Deterministic ID based on content hash
  organizationId  String
  documentId      String
  versionId       String
  chunkIndex      Int
  text            String    @db.Text
  tokenCount      Int
  pageNumbers     String?
  sectionTitle    String?
  metadata        Json?
  embeddingStatus String    @default("PENDING") // PENDING, COMPLETED, FAILED
  embeddingModel  String?
  embeddingDim    Int?
  vectorData      Float[]
  indexingStatus  String    @default("PENDING") // PENDING, COMPLETED, FAILED
  indexedAt       DateTime?
  qdrantPointId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@index([versionId])
  @@index([embeddingStatus])
}

model DocumentPermission {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  accessType String // "READ", "WRITE"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// AI CHAT & COMMUNICATION
// -----------------------------------------------------------------------------

model Chat {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  title          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  organizationId String
  chatId         String
  userId         String? // null if system/AI
  role           String // "user", "assistant", "system"
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chat         Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([chatId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// SECURITY & OBSERVABILITY
// -----------------------------------------------------------------------------

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  actorId        String?
  action         AuditAction
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  token          String   @unique
  roleId         String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model APIKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model UserMemory {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  key            String
  value          String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([organizationId])
  @@index([userId])
}

model ConnectorPolicy {
  id                 String   @id @default(uuid())
  organizationId     String
  connectedAccountId String
  resourcePattern    String   // Exact repository identifier e.g. "owner/repo"
  allowedRoles       String[] @default([])
  allowedDepartments String[] @default([])
  allowedUsers       String[] @default([])
  deniedRoles        String[] @default([])
  deniedDepartments  String[] @default([])
  deniedUsers        String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, resourcePattern])
  @@index([organizationId])
  @@index([connectedAccountId])
}


