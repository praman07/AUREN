DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ekos_db?schema=public&client_encoding=utf8"
REDIS_URL="redis://127.0.0.1:6379"

# Inference Providers Configuration

# ollama enable 
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434

# llama enable 
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://127.0.0.1:8080
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_URL=http://127.0.0.1:11434

# Ollama (local LLM)
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_MODEL_FAST=ornith:9b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_API_URL=http://127.0.0.1:11434

# llama.cpp (llama-server) Configuration
# To switch to llama.cpp: set LLM_PROVIDER=llamacpp and LLM_BASE_URL=http://127.0.0.1:8080
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=qwen2.5:14b
LLAMACPP_MODEL_FAST=qwen3.5:9b-q4_K_M
LLAMACPP_NUM_CTX=4096

# Web Search Pipeline — Self-hosted only (no external APIs, no API keys)
# Both services run via: docker-compose up -d searxng crawl4ai
SEARXNG_URL=http://127.0.0.1:8080
CRAWL4AI_URL=http://127.0.0.1:11235
CRAWL4AI_API_TOKEN=auren_crawl4ai_secret_token_2026

# Web pipeline tuning
WEB_SEARCH_RESULTS=8
WEB_MAX_CRAWL_URLS=4
WEB_MAX_CONTENT_CHARS=6000
WEB_CRAWL_TIMEOUT_MS=12000
PORT=5000  

