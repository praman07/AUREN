DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ekos_db?schema=public&client_encoding=utf8"
REDIS_URL="redis://127.0.0.1:6379"

# Inference Providers Configuration
# Active Providers
LLM_PROVIDER=llamacpp
EMBEDDING_PROVIDER=llamacpp
VISION_PROVIDER=llamacpp

# =============================================================
# GENERATION MODEL — Single Multimodal LLM
# Qwen2.5-VL-3B-Instruct Q4_K_M (text + vision)
# llama.cpp server running on port 8083
# =============================================================
LLM_BASE_URL=http://127.0.0.1:8083
LLAMACPP_BASE_URL=http://127.0.0.1:8083

GENERATION_MODEL=qwen2.5-vl-3b-instruct
LLAMACPP_MODEL=qwen2.5-vl-3b-instruct
LLAMACPP_CHAT_MODEL=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
LLAMACPP_NUM_CTX=8192

# =============================================================
# EMBEDDING MODEL — UNCHANGED
# nomic-embed-text.gguf on port 8081, 768 dimensions
# DO NOT CHANGE THESE VALUES
# =============================================================
LLAMACPP_EMBEDDING_BASE_URL=http://127.0.0.1:8081
LLAMACPP_EMBEDDING_MODEL=nomic-embed-text:latest
LLAMACPP_EMBEDDING_DIM=768


# Web Search Pipeline — Self-hosted only (no external APIs, no API keys)
# Both services run via: docker-compose up -d searxng crawl4ai
SEARXNG_URL=http://127.0.0.1:8080
CRAWL4AI_URL=http://127.0.0.1:11235
CRAWL4AI_API_TOKEN=auren_crawl4ai_secret_token_2026

# Web pipeline tuning
WEB_SEARCH_RESULTS=8
WEB_MAX_CRAWL_URLS=4
WEB_MAX_CONTENT_CHARS=6000
WEB_CRAWL_TIMEOUT_MS=12000
PORT=5000  

